    "tab.activeBorderTop": "#93A98C",
    "tab.unfocusedActiveBorderTop": "#BACBB4",
    "activityBar.background": "#3C4D39",
    "activityBar.foreground": "#FBF8F1",
    "activityBar.inactiveForeground": "#FBF8F173",
    "activityBar.border": "#3C4D39",
    "activityBar.activeBorder": "#93A98C",
    "activityBar.activeBackground": "#93A98C29",
    "activityBarBadge.background": "#93A98C",
    "activityBarBadge.foreground": "#0A0908",
    "sideBar.background": "#1f271d",
    "sideBar.foreground": "#EDE6D6",
    "sideBar.border": "#3C4D39",
    "sideBarTitle.foreground": "#FBF8F1",
    "sideBarSectionHeader.background": "#263024",
    "sideBarSectionHeader.foreground": "#EDE6D6",
    "sideBarSectionHeader.border": "#3C4D39",
    "list.activeSelectionBackground": "#93A98C52",
    "list.activeSelectionForeground": "#FBF8F1",
    "list.inactiveSelectionBackground": "#93A98C29",
    "list.hoverBackground": "#93A98C1a",
    "list.focusBackground": "#93A98C42",
    "list.highlightForeground": "#BACBB4",
    "list.dropBackground": "#93A98C47",
    "tree.indentGuidesStroke": "#242A21",
    "statusBar.background": "#3C4D39",
    "statusBar.foreground": "#FBF8F1",
    "statusBar.border": "#3C4D39",
    "statusBar.debuggingBackground": "#E0492E",
    "statusBar.debuggingForeground": "#0A0908",
    "statusBar.noFolderBackground": "#3C4D39",
    "statusBarItem.remoteBackground": "#93A98C",
    "statusBarItem.remoteForeground": "#0A0908",
    "statusBarItem.hoverBackground": "#FBF8F11f",
    "statusBarItem.prominentBackground": "#0A090859",
    "titleBar.activeBackground": "#3C4D39",
    "titleBar.activeForeground": "#FBF8F1",
    "titleBar.inactiveBackground": "#2b3729",
    "titleBar.inactiveForeground": "#8E887A",
    "titleBar.border": "#3C4D39",
    "panel.background": "#1f271d",
    "panel.border": "#3C4D39",
    "panelTitle.activeForeground": "#FBF8F1",
    "panelTitle.activeBorder": "#93A98C",
    "panelTitle.inactiveForeground": "#8E887A",
    "breadcrumb.foreground": "#8E887A",
    "breadcrumb.focusForeground": "#EDE6D6",
    "breadcrumb.activeSelectionForeground": "#93A98C",
    "breadcrumbPicker.background": "#181D16",
    "badge.background": "#93A98C",
    "badge.foreground": "#0A0908",
    "button.background": "#93A98C",
    "button.foreground": "#0A0908",
    "button.hoverBackground": "#BACBB4",
    "button.secondaryBackground": "#181D16",
    "button.secondaryForeground": "#EDE6D6",
    "button.secondaryHoverBackground": "#242A21",
    "input.background": "#181D16",
    "input.foreground": "#EDE6D6",
    "input.border": "#242A21",
    "input.placeholderForeground": "#615C52",
    "inputOption.activeBorder": "#93A98C",
    "inputValidation.errorBackground": "#E0492E",
    "inputValidation.errorBorder": "#E0492E",
    "dropdown.background": "#181D16",
    "dropdown.foreground": "#EDE6D6",
    "dropdown.border": "#3C4D39",
    "scrollbarSlider.background": "#93A98C24",
    "scrollbarSlider.hoverBackground": "#93A98C47",
    "scrollbarSlider.activeBackground": "#93A98C73",
    "progressBar.background": "#93A98C",
    "notificationCenter.border": "#3C4D39",
    "notificationCenterHeader.background": "#1f271d",
    "notificationToast.border": "#3C4D39",
    "notifications.background": "#181D16",
    "notifications.foreground": "#EDE6D6",
    "notifications.border": "#3C4D39",
    "pickerGroup.foreground": "#93A98C",
    "pickerGroup.border": "#242A21",
    "quickInput.background": "#181D16",
    "quickInput.foreground": "#EDE6D6",
    "gitDecoration.addedResourceForeground": "#5FBF7A",
    "gitDecoration.modifiedResourceForeground": "#93A98C",
    "gitDecoration.deletedResourceForeground": "#E0492E",
    "gitDecoration.untrackedResourceForeground": "#7FD8F0",
    "gitDecoration.ignoredResourceForeground": "#615C52",
    "gitDecoration.conflictingResourceForeground": "#E0492E",
    "diffEditor.insertedTextBackground": "#5FBF7A24",
    "diffEditor.removedTextBackground": "#E0492E24",
    "diffEditor.insertedLineBackground": "#5FBF7A14",
    "diffEditor.removedLineBackground": "#E0492E14",
    "terminal.background": "#0A0C09",
    "terminal.foreground": "#EDE6D6",
    "terminalCursor.foreground": "#93A98C",
    "terminal.ansiBlack": "#14120F",
    "terminal.ansiRed": "#C7452B",
    "terminal.ansiGreen": "#7FA83F",
    "terminal.ansiYellow": "#D4A017",
    "terminal.ansiBlue": "#4A7FA8",
    "terminal.ansiMagenta": "#8A6FC4",
    "terminal.ansiCyan": "#3E9EAF",
    "terminal.ansiWhite": "#C8C0AE",
    "terminal.ansiBrightBlack": "#3A342A",
    "terminal.ansiBrightRed": "#E0492E",
    "terminal.ansiBrightGreen": "#A8E01F",
    "terminal.ansiBrightYellow": "#F0C24B",
    "terminal.ansiBrightBlue": "#7FB3D8",
    "terminal.ansiBrightMagenta": "#B0A7C9",
    "terminal.ansiBrightCyan": "#7FD8F0",
    "terminal.ansiBrightWhite": "#FBF8F1"
  },
  "tokenColors": [
    {
      "scope": [
        "comment",
        "punctuation.definition.comment"
      ],
      "settings": {
        "foreground": "#615C52",
        "fontStyle": "italic"
      }
    },
    {
      "scope": [
        "string",
        "string.quoted",
        "string.template"
      ],
      "settings": {
        "foreground": "#5FBF7A"
      }
    },
    {
      "scope": [
        "constant.numeric"
      ],
      "settings": {
        "foreground": "#F0C24B"
      }
    },
    {
      "scope": [
        "constant.language",
        "constant.character.escape"
      ],
      "settings": {
        "foreground": "#BACBB4"
      }
    },
    {
      "scope": [
        "keyword",
        "keyword.control",
        "storage",
        "storage.type",
        "storage.modifier"
      ],
      "settings": {
        "foreground": "#93A98C"
      }
    },
    {
      "scope": [
        "keyword.operator"
      ],
      "settings": {
        "foreground": "#C8C0AE"
      }
    },
    {
      "scope": [
        "entity.name.function",
        "support.function",
        "meta.function-call"
      ],
      "settings": {
        "foreground": "#BACBB4"
      }
    },
    {
      "scope": [
        "entity.name.type",
        "entity.name.class",
        "support.type",
        "support.class",
        "entity.other.inherited-class"
      ],
      "settings": {
        "foreground": "#7FD8F0"
      }
    },
    {
      "scope": [
        "entity.name.tag"
      ],
      "settings": {
        "foreground": "#93A98C"
      }
    },
    {
      "scope": [
        "entity.other.attribute-name"
      ],
      "settings": {
        "foreground": "#BACBB4"
      }
    },
    {
      "scope": [
        "variable",
        "variable.other"
      ],
      "settings": {
        "foreground": "#EDE6D6"
      }
    },
    {
      "scope": [
        "variable.parameter"
      ],
      "settings": {
        "foreground": "#EDE6D6",
        "fontStyle": "italic"
      }
    },
    {
      "scope": [
        "punctuation",
        "meta.brace",
        "punctuation.separator",
        "punctuation.terminator"
      ],
      "settings": {
        "foreground": "#8E887A"
      }
    },
    {
      "scope": [
        "invalid",
        "invalid.illegal"
      ],
      "settings": {
        "foreground": "#E0492E"
      }
    },
    {
      "scope": [
        "markup.heading"
      ],
      "settings": {
        "foreground": "#93A98C",
        "fontStyle": "bold"
      }
    },
    {
      "scope": [
        "markup.bold"
      ],
      "settings": {
        "foreground": "#EDE6D6",
        "fontStyle": "bold"
      }
    },
    {
      "scope": [
        "markup.italic"
      ],
      "settings": {
        "foreground": "#EDE6D6",
        "fontStyle": "italic"
      }
    },
    {
      "scope": [
        "markup.underline.link",
        "string.other.link"
      ],
      "settings": {
        "foreground": "#7FD8F0",
        "fontStyle": "underline"
      }
    },
    {
      "scope": [
        "meta.diff.header",
        "meta.diff.range"
      ],
      "settings": {
        "foreground": "#8E887A"
      }
    }
  ]
}
