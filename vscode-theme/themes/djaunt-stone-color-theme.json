    "editorHoverWidget.background": "#181D16",
    "editorHoverWidget.border": "#242A21",
    "editorSuggestWidget.background": "#181D16",
    "editorSuggestWidget.border": "#242A21",
    "editorSuggestWidget.selectedBackground": "#93A98C33",
    "editorSuggestWidget.highlightForeground": "#93A98C",
    "editorError.foreground": "#E0492E",
    "editorWarning.foreground": "#F0C24B",
    "editorInfo.foreground": "#7FD8F0",
    "editorOverviewRuler.border": "#242A21",
    "editorGroup.border": "#3C4D39",
    "editorGroupHeader.tabsBackground": "#263024",
    "editorGroupHeader.tabsBorder": "#3C4D39",
    "tab.activeBackground": "#0A0C09",
    "tab.activeForeground": "#FBF8F1",
    "tab.inactiveBackground": "#263024",
    "tab.inactiveForeground": "#8E887A",
